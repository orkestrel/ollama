{
	"name": "@orkestrel/ollama",
	"version": "0.0.13",
	"description": "A typed local-LLM provider for the @orkestrel line — a ProviderInterface over a local Ollama daemon's /api/chat with NDJSON streaming and guard-narrowed wire boundaries. Part of the @orkestrel line.",
	"keywords": [
		"ai",
		"llm",
		"ollama",
		"provider",
		"server",
		"typescript"
	],
	"homepage": "https://github.com/orkestrel/ollama#readme",
	"bugs": "https://github.com/orkestrel/ollama/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/orkestrel/ollama.git"
	},
	"files": [
		"dist/src",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/src/server/index.cjs",
	"module": "./dist/src/server/index.js",
	"types": "./dist/src/server/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/src/server/index.d.ts",
				"default": "./dist/src/server/index.js"
			},
			"require": {
				"types": "./dist/src/server/index.d.cts",
				"default": "./dist/src/server/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"copy": "node -e \"const fs=require('node:fs'),p=require('node:path'),a=process.argv[1],b=process.argv[2];fs.mkdirSync(p.dirname(b),{recursive:true});fs.cpSync(a,b,{force:true});console.log('Copied: '+a+' to '+b)\"",
		"scaffold": "scaffold",
		"lint": "oxlint --config .oxlintrc.json --fix --deny-warnings .",
		"check": "tsc --noEmit --project tsconfig.json && npm run check:src",
		"check:src": "npm run check:src:server",
		"check:src:server": "tsc --noEmit -p configs/src/tsconfig.server.json",
		"format": "oxfmt --config .oxfmtrc.json --write .",
		"format:check": "oxfmt --config .oxfmtrc.json --check .",
		"lint:check": "oxlint --config .oxlintrc.json --deny-warnings .",
		"test": "npm run test:src && npm run test:setup && npm run test:policy && npm run test:config && npm run test:guides && npm run test:conformance",
		"test:src": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:server",
		"test:src:server": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:server",
		"test:conformance": "vitest run --config vite.config.ts --no-cache --reporter=dot --project conformance",
		"test:service": "vitest run --config vite.config.ts --no-cache --reporter=dot --project service",
		"test:setup": "vitest run --config vite.config.ts --no-cache --reporter=dot --project setup",
		"test:policy": "vitest run --config vite.config.ts --no-cache --reporter=dot --project policy",
		"test:config": "vitest run --config vite.config.ts --no-cache --reporter=dot --project config",
		"test:guides": "vitest run --config vite.config.ts --no-cache --reporter=dot --project guides",
		"build": "npm run clean && npm run build:src",
		"build:src": "npm run build:src:server",
		"build:src:server": "vite build --config configs/src/vite.server.config.ts && npm run copy dist/src/server/index.d.ts dist/src/server/index.d.cts",
		"prepublishOnly": "npm run format:check && npm run lint:check && npm run check && npm run build && npm test && npm run test:distribution -- --mode release && npm run test:service",
		"test:distribution": "vitest run --config vite.config.ts --no-cache --reporter=dot --project distribution",
		"test:probe": "vitest run --config vite.config.ts --no-cache --reporter=verbose --project probe",
		"test:bench": "vitest bench --config vite.config.ts --no-cache --project probe",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@orkestrel/agent": "^0.0.19",
		"@orkestrel/budget": "^0.0.8",
		"@orkestrel/contract": "^0.0.15",
		"@orkestrel/ndjson": "^0.0.8",
		"@orkestrel/timeout": "^0.0.8",
		"@orkestrel/tool": "^0.0.12"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.59.0",
		"@orkestrel/abort": "^0.0.8",
		"@orkestrel/guide": "^0.0.15",
		"@orkestrel/probe": "^0.0.11",
		"@orkestrel/router": "^0.0.12",
		"@orkestrel/scaffold": "^0.0.60",
		"@orkestrel/server": "^0.0.17",
		"@orkestrel/test": "^0.0.12",
		"@orkestrel/workspace": "^0.0.6",
		"@types/node": "^26.4.0",
		"ollama": "0.6.3",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
